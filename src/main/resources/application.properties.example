# Configuração acadêmica local. Para produção, sobrescreva os valores via variáveis de ambiente.
spring.datasource.url=${DATABASE_URL:jdbc:postgresql://localhost:5432/notasalp}
spring.datasource.username=${DATABASE_USERNAME:seu_usuario}
spring.datasource.password=${DATABASE_PASSWORD:sua_senha}
spring.jpa.hibernate.ddl-auto=${JPA_DDL_AUTO:update}
spring.jpa.show-sql=${JPA_SHOW_SQL:false}
spring.jpa.properties.hibernate.format_sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# Chave com no mínimo 32 bytes. Substitua em qualquer ambiente compartilhado.
jwt.secret=${JWT_SECRET:chave-academica-local-notasalp-32-bytes-minimo}
jwt.expiration=${JWT_EXPIRATION:28800000}

# Desativado por padrão; usuários registrados recebem CONSULTOR, nunca ADMIN.
app.auth.public-registration=${AUTH_PUBLIC_REGISTRATION:false}
app.auth.cookie-secure=${AUTH_COOKIE_SECURE:false}

# Actuator mínimo para acompanhar se a aplicação está viva.
management.endpoints.web.exposure.include=health,info,metrics
management.endpoint.health.probes.enabled=true
management.endpoint.health.show-details=when_authorized
app.frontend.origin=${FRONTEND_ORIGIN:http://localhost:3000}
spring.flyway.baseline-on-migrate=true
spring.flyway.enabled=${FLYWAY_ENABLED:true}
# Bootstrap opcional do primeiro administrador; nunca versionar estes valores reais.
app.admin.name=${ADMIN_NAME:Administrador}
app.admin.email=${ADMIN_EMAIL:}
app.admin.password=${ADMIN_PASSWORD:}

app.auth.cookie-same-site=${AUTH_COOKIE_SAME_SITE:Lax}
